# Copy to .env on the EC2 box:  cp .env.example .env  && nano .env
# docker-compose.yml loads this file into the `app` container.

# ---- AWS / S3 (durable storage) -------------------------------------------
# The EC2 instance uses an IAM ROLE for S3 access — do NOT put access keys here.
AWS_REGION=ap-south-1
S3_BUCKET=cmt-storage-CHANGE-ME

# ---- Auth ------------------------------------------------------------------
# REQUIRED. Random 32+ byte secret used to sign the session cookie.
#   openssl rand -base64 48
SESSION_SECRET=

# ---- Disk / RAM layout -----------------------------------------------------
# EBS working store (scan JSON, originals, render/merge outputs). Bind-mounted
# from the host in docker-compose.yml.
DATA_DIR=/data
# Local media cap used by the "storage used" check (GB). Match the EBS size.
DISK_LIMIT_GB=100
# RAM (tmpfs) hot area for ffmpeg intermediates.
WORK_DIR=/dev/shm/cmt
# How much of the tmpfs ffmpeg may use before spilling to DATA_DIR/work.
# 6 GB leaves ~8 GB for Node + 16 ffmpeg processes on a 16 GB box.
WORK_RAM_BUDGET_MB=6144

# ---- ffmpeg ----------------------------------------------------------------
# auto = os.availableParallelism() (16 cores -> 16 engines). Or a number.
FFMPEG_ENGINES=auto
# Binaries come from the Docker image (/usr/bin). Override only if needed.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---- App -------------------------------------------------------------------
# Keep at most this many scans (videos); the oldest is deleted when exceeded.
MAX_SCANS=10

# ---- Caddy (reverse proxy) --------------------------------------------------
# Public hostname for automatic HTTPS. Use ":80" until DNS points at the box.
SITE_ADDRESS=:80
